# --- PostgreSQL ---
POSTGRES_USER=boussolefret
POSTGRES_PASSWORD=change_me
POSTGRES_DB=boussolefret

# --- MinIO ---
MINIO_ROOT_USER=boussolefret
MINIO_ROOT_PASSWORD=change_me_too

# --- Sécurité ---
JWT_SECRET=change_me_with_a_long_random_string

# --- IA / LLM ---
# Clé de l'API du modèle de langage utilisé par le service Go interne
LLM_API_KEY=

# --- Interne (généralement pas à modifier en local) ---

# --- RAG (complète LLM_API_KEY déjà présent plus haut) ---
LLM_API_URL=https://api.ton-fournisseur-llm.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
SIMILARITY_MIN=0.72
